# ClassConnect web app configuration.
#
# Copy to .env and edit. The real .env is gitignored, this file is not.
#
# ---------------------------------------------------------------------
# READ THIS BEFORE ADDING ANYTHING
# ---------------------------------------------------------------------
# Every VITE_ variable is inlined into the JavaScript bundle at build
# time. It is not read at runtime and it is not private: it ships to the
# browser as a string literal that anybody can read with view source.
#
# So nothing secret belongs in this file. No API keys, no Stripe secret,
# no database credentials, no JWT signing secret. Those live in
# apps/api/.env, are read by the server, and never leave it. A key put
# here is a published key, and rotating it means a rebuild.
#
# Vite enforces half of this: a variable without the VITE_ prefix is not
# exposed to client code at all. That is a guard against leaking by
# accident, not permission to leak on purpose.
# ---------------------------------------------------------------------


# Where the dev server proxies /api during `npm run dev`.
#
# Development only. Vite reads this in vite.config.js, on the Node side,
# so it never reaches the bundle. Change it when the API is on another
# port or another machine.
VITE_API_TARGET=http://127.0.0.1:8000


# The base the client prefixes onto every API call.
#
# Leave it unset. The default is the relative path /api/v1, which is
# correct in development (the dev server proxies it, so there is no CORS
# in the loop) and correct in production when the app and the API are
# served from one origin behind a reverse proxy, which is the intended
# deployment.
#
# Set it only when the API genuinely lives on a different origin, for
# example a separately hosted staging API:
#
#   VITE_API_URL=https://api.staging.classconnect.app/api/v1
#
# Doing that puts you in cross origin territory, so the API's
# CORS_ORIGINS has to name this app's origin or every request fails the
# preflight. Prefer the reverse proxy.
#
# VITE_API_URL=
