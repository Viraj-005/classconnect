# Copy to .env and fill in. Never commit .env.

ENV=development
DEBUG=true

# One Postgres database, shared schema, org_id on every tenant table.
#
# Give it the five parts and the URL is assembled for you, which also
# percent encodes the password. Do that rather than writing the URL by
# hand: a password containing # or @ or / makes a URL that a strict
# parser reads as a different host entirely.
DB_NAME=classconnect
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Leave DATABASE_URL unset unless you need a target the five parts
# cannot describe. When it is set it wins, and a stale value here
# silently overrides everything above.
# DATABASE_URL=

# Leave all six blank to fall back to SQLite at apps/api/classconnect.db,
# which is enough to run the app but is not what production uses.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
QR_SIGNING_SECRET=

CORS_ORIGINS=["http://localhost:5173"]

AWS_REGION=ap-south-1
S3_BUCKET=classconnect-media

# Student fee payments: a tenant charging its own students.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Platform billing: LoopLab charging the tenant. Deliberately separate
# credentials so the two money flows cannot be confused in config either.
STRIPE_BILLING_API_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# Rate limits on the unauthenticated endpoints
# ---------------------------------------------------------------------
# Counted in one process's memory, so these reset on restart and each
# worker counts separately. They are a floor, not the control. Put a per
# IP limit in front of the app before launch.
#
# The per address login figure is deliberately generous. A school signs
# in from one building through one NAT address, so a tight limit there
# locks out the customer rather than the attacker. The narrow limit is
# per address AND account, which is where a brute force actually shows.
#
# LOGIN_FAILURES_PER_ACCOUNT=8
# LOGIN_FAILURES_PER_ADDRESS=60
# LOGIN_WINDOW_SECONDS=900
# SIGNUP_PER_ADDRESS=5
# SIGNUP_WINDOW_SECONDS=3600
